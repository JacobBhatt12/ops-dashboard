# Copy this file to .env and fill in the real value.
# .env is gitignored — it never gets committed.

# Fine-grained personal access token (github.com -> Settings -> Developer
# settings -> Personal access tokens -> Fine-grained tokens).
# Needs, per selected client repo: Deployments (read), Actions (read),
# Dependabot alerts (read). Nothing else.
GITHUB_TOKEN=

# hPanel -> Developer -> API Tokens
HOSTINGER_API_KEY=

# The Gmail address reports and client emails are sent from.
GMAIL_ADDRESS=

# Google Account -> Security -> App Passwords (2FA must be on).
GMAIL_APP_PASSWORD=

# console.cloud.google.com -> enable PageSpeed Insights API -> Credentials (free).
PAGESPEED_API_KEY=

# Where the SMS summary is sent after each run, e.g. a carrier
# email-to-SMS gateway like 5551234567@tmomail.net.
YOUR_SMS_EMAIL=

# Outreach-bot status pings. The ntfy topic name acts as a password —
# pick a long random one and subscribe to it in the ntfy phone app.
NTFY_TOPIC=
# Optional fallback: carrier email-to-SMS gateway, e.g. 5551234567@tmomail.net.
NOTIFY_SMS_TO=
